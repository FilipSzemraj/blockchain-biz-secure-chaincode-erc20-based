# === Build artifacts ===
# Chaincode (Java/Gradle)
chaincode/build/
chaincode/.gradle/
chaincode/out/

# Backend (Java/Gradle)
backend/*/build/
backend/*/.gradle/
backend/*/out/

# Frontend (Node.js)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# === IDE and editor files ===
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# === OS generated files ===
.DS_Store
Thumbs.db

