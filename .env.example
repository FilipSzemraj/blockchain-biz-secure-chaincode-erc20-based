# ============================================================
# Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# --- JWT Authentication ---
JWT_SECRET=your-256-bit-secret-here
JWT_EXPIRATION_ACCESS=300000         # 5 minutes (ms)
JWT_EXPIRATION_REFRESH=604800000     # 7 days (ms)

# --- PostgreSQL Database ---
POSTGRES_URL=jdbc:postgresql://localhost:5432/fabric_client_db
POSTGRES_USER=fabric_user
POSTGRES_PASSWORD=fabric_password

# --- Fabric Network (per-organization, set via Docker environment) ---
FABRIC_MSP_ID=FurnituresMakersMSP
FABRIC_GATEWAY_ADDRESS=peer0.furnituresmakers.com:7051
FABRIC_CERT_PATH=/path/to/signcerts/cert.pem
FABRIC_KEY_PATH=/path/to/keystore/key.pem
FABRIC_TLS_CERT_CA_PATH=/path/to/tlscacerts/tls-ca-cert.pem
FABRIC_TLS_CERT_PATH=/path/to/tls/signcerts/cert.pem
FABRIC_TLS_KEY_PATH=/path/to/tls/keystore/key.pem

# --- Bank API ---
BANK_API_PORT=8081
BANK_KEY_PUBLIC_PATH=/var/app/keys/public_key.pem
BANK_KEY_PRIVATE_PATH=/var/app/keys/private_key.pem

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
